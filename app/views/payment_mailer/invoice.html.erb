<h2>Payment Invoice</h2>

<p>Dear <%= @family.name %>,</p>

<p>Here is your invoice for <%= @child.first_name %> <%= @child.last_name %>'s enrollment in <%= @program.name %>.</p>

<h3>Payment Details</h3>
<ul>
  <li><strong>Amount:</strong> <%= number_to_currency(@payment.amount) %></li>
  <li><strong>Invoice Date:</strong> <%= @payment.payment_date.strftime('%B %d, %Y') %></li>
  <% if @payment.payment_type == 'enrollment_fee' %>
  <li><strong>Type:</strong> Non-refundable Enrollment Fee</li>
  <% elsif @payment.payment_type == 'tuition' %>
  <li><strong>Type:</strong> Tuition Payment<%= " - Installment ##{@payment.installment_number}" if @payment.installment_number %></li>
  <% end %>
</ul>

<% if @payment.notes.present? %>
<p><strong>Notes:</strong> <%= @payment.notes %></p>
<% end %>

<p style="margin: 24px 0;">
  <a href="<%= @pay_url %>" style="background-color: #2e7d32; color: #ffffff; text-decoration: none; font-weight: bold; padding: 14px 28px; border-radius: 6px; display: inline-block;">
    Pay <%= number_to_currency(@payment.amount) %> Securely
  </a>
</p>
<p style="font-size: 13px; color: #666;">Pay by card through our secure Stripe page — a receipt is emailed to you automatically. If the button doesn't work, paste this link into your browser:<br><%= @pay_url %></p>

<% if @payment.program_enrollment.enrollment_payment_plan %>
  <% plan = @payment.program_enrollment.enrollment_payment_plan %>
  <% total_paid = plan.total_paid + (plan.enrollment_fee_paid? ? plan.enrollment_fee : 0) %>
  <% remaining = plan.total_amount - plan.total_paid %>

  <h3>Payment Plan Status</h3>
  <ul>
    <li><strong>Plan:</strong> <%= plan.payment_plan.name %></li>
    <li><strong>Total Tuition:</strong> <%= number_to_currency(plan.total_amount) %></li>
    <li><strong>Total Paid:</strong> <%= number_to_currency(total_paid) %></li>
    <li><strong>Remaining Balance:</strong> <%= number_to_currency(remaining) %></li>
  </ul>

  <% if remaining > 0 %>
    <% next_installment = plan.next_installment %>
    <% if next_installment %>
      <p><strong>Next Payment:</strong> <%= number_to_currency(next_installment['amount']) %> due on <%= Date.parse(next_installment['due_date']).strftime('%B %d, %Y') %></p>
    <% end %>
  <% else %>
    <p style="color: green;"><strong>Your account is paid in full!</strong></p>
  <% end %>
<% end %>

<p>If you have any questions about this payment or your account, please don't hesitate to contact us.</p>

<p>Thank you for being part of the Earthkin community!</p>

<p>Warmly,<br>
The Earthkin Team</p>
